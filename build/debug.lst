 159:funsape/util/../globalDefines.hpp **** //!
 160:funsape/util/../globalDefines.hpp **** //! @def            isGpioAddressValid(gpioPort)
 161:funsape/util/../globalDefines.hpp **** //! @details        Checks if the given parameter @a gpioPort is a valid GPIO
 162:funsape/util/../globalDefines.hpp **** //!                     port address. Valid GPIO addresses are @c DDRx, @c PORTx
 163:funsape/util/../globalDefines.hpp **** //!                     and @c PINx register addresses.
 164:funsape/util/../globalDefines.hpp **** //! @param[in]      gpioPort            GPIO port address
 165:funsape/util/../globalDefines.hpp **** //! @retval         true                if GPIO address is valid
 166:funsape/util/../globalDefines.hpp **** //! @retval         false               if GPIO address is not valid
 167:funsape/util/../globalDefines.hpp **** //!
 168:funsape/util/../globalDefines.hpp **** #define isGpioAddressValid(gpioPort)    (bool_t)(       \
 169:funsape/util/../globalDefines.hpp ****         (IS_GPIO_ALL_INSTANCE(gpioPort))                \
 170:funsape/util/../globalDefines.hpp ****         ? true                                          \
 171:funsape/util/../globalDefines.hpp ****         : false                                         \
 172:funsape/util/../globalDefines.hpp **** )
 173:funsape/util/../globalDefines.hpp **** 
 174:funsape/util/../globalDefines.hpp **** //!
GAS LISTING /tmp/ccEXNQ0T.s 			page 15


 175:funsape/util/../globalDefines.hpp **** //! @def            isGpioPinIndexValid(gpioPort, gpioPin)
 176:funsape/util/../globalDefines.hpp **** //! @details        Checks if the given parameter @a gpioPin of the given
 177:funsape/util/../globalDefines.hpp **** //!                     @a gpioPort is a valid GPIO pin index.
 178:funsape/util/../globalDefines.hpp **** //! @param[in]      gpioPort            GPIO port address
 179:funsape/util/../globalDefines.hpp **** //! @param[in]      gpioPin             GPIO pin index
 180:funsape/util/../globalDefines.hpp **** //! @retval         true                if GPIO pin index is valid
 181:funsape/util/../globalDefines.hpp **** //! @retval         false               if GPIO pin index is not valid
 182:funsape/util/../globalDefines.hpp **** //!
 183:funsape/util/../globalDefines.hpp **** #define isGpioPinIndexValid(gpioPort, gpioPin)    (bool_t)(     \
 184:funsape/util/../globalDefines.hpp ****         (IS_GPIO_ALL_PIN_NUMBER(gpioPort, gpioPin))             \
 185:funsape/util/../globalDefines.hpp ****         ? true                                                  \
 186:funsape/util/../globalDefines.hpp ****         : false                                                 \
 187:funsape/util/../globalDefines.hpp **** )
 188:funsape/util/../globalDefines.hpp **** 
 189:funsape/util/../globalDefines.hpp **** //!
 190:funsape/util/../globalDefines.hpp **** //! @def            isPointerValid(ptr)
 191:funsape/util/../globalDefines.hpp **** //! @details        Checks if the given parameter @a ptr is a valid pointer
 192:funsape/util/../globalDefines.hpp **** //!                     address.
 193:funsape/util/../globalDefines.hpp **** //! @param[in]      ptr                 pointer address
