{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Depurar AVR via simavr",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/application.elf",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/avr-gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "setupCommands": [
                {
                    "description": "Habilitar formatação aprimorada do GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "AVR simulate"
        }
    ]
}
