{
    "version": "2.0.0",
    "options": {
        "env": {
            "BOOT_SIZE": "2048", // Boot section size in bytes
            "BUILD_DIR": "build",
            "BUILD_NAME": "application",
            "COMPILE_C_AS_CPP": "1",
            "COMPILER_DEBUG": "1",
            "COMPILER_OPT": "-Og", // -O0/-O1/-O2/-O3/-Os/-Ofast/-Og
            "COMPILER_PATH": "",
            "COMPILER_STD_C": "gnu17", // c89/gnu89/c90/gnu90/c99/gnu99/c11/gnu11/c17/gnu17/c18
            "COMPILER_STD_CPP": "c++17", // c++98/gnu++98/c++03/gnu++03/c++11/gnu++11/c++14/gnu++14/c++17/gnu++17/c++20/gnu++20
            "EXCLUDE_DIRS": "_hide/ doc/ Release/ temp/",
            "LIBRARY_PATH": "",
            "MCU_DEVICE_NAME": "atmega328p", //
            "PROGRAMMER_CONFIG_FILE": "/home/schwarz/settings/avrdude.conf",
            "PROGRAMMER_TYPE": "arduino", // arduino
            "USER_DEFINES_ASM": "",
            "USER_DEFINES_C": "",
            "USER_DEFINES_CPP": "",
            "USER_FLAGS_ASM": "",
            "USER_FLAGS_C": "-Wno-switch -fno-threadsafe-statics -Wl,--gc-sections",
            "USER_FLAGS_CPP": "-Wno-switch -fno-threadsafe-statics -Wl,--gc-sections -mrelax",
            "USER_LIBS": ""
        }
    },
    "tasks": [
        // AVR Simulate
        {
            "label": "AVR simulate",
            "type": "shell",
            "command": "simavr",
            "args": [
                "-g",
                "-m",
                "atmega328p",
                "${workspaceFolder}/build/application.elf"
            ],
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^.*",
                        "endsPattern": "^.*listening on port 1234.*"
                    }
                }
            ]
        },
        // AVR assemble
        {
            "label": "AVR assemble",
            "detail": "AVR - Assemble project",
            "command": "make",
            "args": [
                {
                    "quoting": "weak",
                    "value": "assemble"
                }
            ],
            "runOptions": {
                "instanceLimit": 1,
                "reevaluateOnRerun": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "type": "shell",
            "group": "build",
            "presentation": {
                "clear": true,
                "close": false,
                "echo": true,
                "focus": true,
                "panel": "shared",
                "reveal": "always",
                "revealProblems": "onProblem",
                "showReuseMessage": true
            }
        },
